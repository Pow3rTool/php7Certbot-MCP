# php7certbot-mcp configuration.
# Copy to /opt/php7certbot-mcp/etc/php7certbot-mcp.env on the mcp host (chmod 0600), fill real
# values. Secrets are MOUNTED at runtime, never baked into the image.

# --- this MCP app's identity (php7Certbot-MCP) — front-door AUDIENCE and back-end OBO CLIENT ---
CERTBOT_MCP_CLIENT_ID=REPLACE-with-this-app's-own-Entra-application-(client)-id
CERTBOT_MCP_TENANT_ID=REPLACE-with-your-Entra-tenant-id
# PEM containing the private key + cert (mounted, 0600) — same credential as before, now used
# to authenticate this app as the MIDDLE TIER in an on-behalf-of exchange (client_assertion),
# not to mint an app-only token. No new credential needed.
CERTBOT_MCP_CERT_FILE=/opt/php7certbot-mcp/etc/php7certbot-mcp.pem

# --- certbot back end (OBO, not client-credentials — see server.py header) ---
# ENTRA SETUP NEEDED before this works: this app needs a delegated permission grant for
# certbot's `access_as_user` scope. Either:
#   (a) certbot's app owner adds this app under certbot's "Expose an API" ->
#       "Authorized client applications" for access_as_user (pre-authorizes, no consent prompt
#       needed — same pattern used for the calling MCP client -> this app), or
#   (b) an admin grants tenant-wide admin consent on this app's API permissions blade after
#       adding "APIs my organization uses" -> certbot's app -> access_as_user.
# Without one of these, the OBO token request fails with AADSTS65001 (consent required).
CERTBOT_API_BASE=REPLACE-with-certbot's-API-base-url-e.g.-https://certbot.your-domain.example/api
CERTBOT_RESOURCE=REPLACE-with-certbot's-App-ID-URI-e.g.-api://<certbot-app-id>
CERTBOT_TIMEOUT=45                                            # certbot reads can be slow

# --- front door (every incoming bearer is cryptographically validated) ---
CERTBOT_PUBLIC_HOST=REPLACE-with-public-hostname-nginx-fronts
CERTBOT_PORT=8785
CERTBOT_REQUIRED_SCOPE=access_as_user                        # coarse valid-caller scope on THIS app
CERTBOT_ALLOWED_CLIENTS=REPLACE-with-the-calling-MCP-client's-application-id  # pin the caller
# CERTBOT_READ_ROLES=                                        # empty = any validated caller may read
#                                                              (certbot's own Bouncer authz still applies)
# CERTBOT_AUDIT_LOG=/opt/php7certbot-mcp/logs/audit.log
